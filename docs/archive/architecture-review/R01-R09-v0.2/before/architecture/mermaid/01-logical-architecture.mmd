flowchart TB
  %% diagram: 01-logical-architecture
  USER["运营 / 采购 / 仓库 / 客服 / 财务 / 审批 / 集成 / 审计"]
  subgraph SYSTEM["完整逻辑系统：层与能力组不代表独立部署单元"]
    subgraph L1["L1 体验与接入层"]
      W01["W01 统一工作台与 API 入口"]
    end
    subgraph L2["L2 场景与任务编排层：两个职责分别展开"]
      direction TB
      subgraph SCENES["场景层：ScenarioHandler声明问题、证据与业务约束"]
        direction TB
        subgraph CORE["P0 首期场景"]
          direction LR
          S01["S01 供需与库存分析"]
          S02["S02 履约风险分析"]
          S03["S03 客户体验分析 / VOC"]
          S04["S04 贡献与费用分析"]
          S01 ~~~ S02 ~~~ S03 ~~~ S04
        end
        subgraph NEXT["P1 拓展场景"]
          direction LR
          S05["S05 客服辅助"]
          S06["S06 内容与增长辅助"]
          S07["S07 单证辅助"]
          S05 ~~~ S06 ~~~ S07
        end
        subgraph LATER["P2 探索场景"]
          direction LR
          S08["S08 经营规划"]
          S09["S09 视觉质检辅助"]
          S10["S10 政策核查辅助"]
          S08 ~~~ S09 ~~~ S10
        end
        CORE ~~~ NEXT ~~~ LATER
      end
      subgraph TASK["任务编排层：统一执行，不复制业务引擎"]
        O01["O01 任务编排<br/>计划 / 调度 / 综合 / 审校 / 预算 / 报告"]
      end
      O01 -->|按已注册契约调度与收集结果| SCENES
    end
  subgraph L3["L3 通用能力层"]
    direction LR
    subgraph DOMAIN["领域计算"]
      direction TB
      B01["B01 指标语义与计算"]
      B02["B02 预测与优化"]
    end
    subgraph INTELLIGENCE["通用智能：模型仅可用允许的只读工具"]
      direction TB
      A01["A01 模型网关"]
      A02["A02 内容理解与抽取"]
      A03["A03 检索与受控查询"]
    end
    subgraph COLLAB["协同控制：不向模型暴露外部写工具"]
      direction TB
      C01["C01 建议与预警"]
      C02["C02 审批与授权"]
      C03["C03 受控执行与结果跟踪"]
    end
  end
  subgraph L4["L4 数据与集成层"]
    direction LR
    D01["D01 连接器与同步"]
    D02["D02 标准身份与投影"]
    D03["D03 数据质量与快照"]
    D04["D04 证据登记与血缘"]
  end
  subgraph L5["L5 运行基础层 / 基础设施层"]
    I01["I01 运行基础<br/>持久化 / 必要索引 / 任务调度 / 文件与密钥 / 备份恢复"]
  end
  end
  subgraph GOVERNANCE["横向治理：作用于各层及适配边界"]
    G01["G01 权限与策略<br/>角色 / 企业 / 店铺 / 仓库 / 字段 / 工具"]
    G02["G02 审计、观测与评测<br/>追踪 / 版本 / 质量 / 费用 / 恢复验证"]
  end
  READ["原系统授权读取端口<br/>ERP / OMS / WMS / CRM / 财务 / 渠道 / 授权知识"]
  WRITE["原 ERP / CRM 受控写端口<br/>首期仅采购草稿 / 内部工单"]
  MODEL["经授权的模型提供方<br/>云端或本地实现择需选择"]

  USER --> W01
  W01 -->|提交问题与可信范围；统一确认和审批入口| L2
  L2 -->|通过稳定端口组合通用能力| L3
  L3 -->|标准事实、固定快照与证据引用| L4
  L4 -.->|存储、索引、调度与密钥承载| I01
  A02 -->|按需模型理解| A01
  A03 -->|模型查询规划经网关| A01
  B01 -->|指标与模拟输入| B02
  C01 -->|确认后提交审批| C02
  C02 -->|有效批准和授权触发后复核| C03
  COLLAB -->|仅C03经ActionAdapter写入| WRITE
  INTELLIGENCE -->|仅经A01模型适配| MODEL
  L4 -->|D01授权只读| READ
  D01 -->|交付带来源的记录| D02
  D02 -->|版本投影校验| D03
  D03 -->|快照与来源血缘| D04
  G01 -.->|作用于各层、来源、缓存、工具和执行边界| SYSTEM
  G02 -.->|贯穿任务、数据、模型、动作和基础设施| SYSTEM

