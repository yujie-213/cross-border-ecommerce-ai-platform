flowchart TB
  %% diagram: 05-system-data-flow
  EXTERNAL["外部业务事实与授权资料<br/>ERP：商品、供应、采购；OMS：订单、退款、售后<br/>WMS：库存、质检、包裹、履约；CRM：反馈、工单<br/>财务：费用、成本、结算；渠道：刊登、访问、广告<br/>授权知识、文件及后续获批的新来源"]
  USER["业务人员与独立审批人员"]
  W["W01 工作台 / API"]
  CFG["S01—S10 场景声明<br/>证据/依赖、特征、参数及输出模式"]
  O["O01 统一计划与调度<br/>联合报告综合、审校及整体业务状态"]
  SC["所选ScenarioHandler<br/>执行业务步骤、调用公共能力<br/>返回领域结论、产物引用及业务限制"]
  D1["D01 授权读取、增量同步、去重<br/>来源记录、游标、覆盖水位"]
  D2["D02 标准化<br/>身份 / 单位 / 状态 / 权威域 / 版本"]
  V[("标准投影与版本<br/>唯一写入：D02")]
  D3{"D03 质量门槛<br/>完整 / 新鲜 / 一致 / 映射可靠"}
  BAD[("质量问题及隔离引用<br/>唯一写入：D03；原记录仍保留来源")]
  SNAP[("冻结输入数据版本清单<br/>snapshotId唯一维护：D03")]
  E[("证据资产定位、版本与派生关系<br/>D04维护引用，不复制清单或产物")]
  B1["B01 唯一确定性指标评价<br/>可售 / 逐日供需 / 分母 / 贡献"]
  B2["B02 预测、情景及候选优化<br/>所有逐日评价复用B01"]
  A2["A02 内容理解<br/>文本主题；文档及图像按期扩展"]
  A3["A03 检索与受控查询<br/>权限过滤 / 语义计划 / 引用解析"]
  A1["A01 模型网关<br/>调用 / 技术预算 / 模式校验 / 技术错误"]
  MODEL["经授权模型提供方"]
  ART[("指标 / 预测 / 理解派生产物<br/>分别由B01 / B02 / A02独占写入")]
  REPORT[("任务planVersion、领域结论及产物引用<br/>reportVersion与报告正文仅O01维护")]
  C1["C01 去重预警与版本化建议<br/>参数 / 证据 / 风险 / 责任人"]
  HUMAN["经W01确认具体建议<br/>另一授权人员作出审批决策"]
  C2["C02 审批记录<br/>批准范围 / 参数指纹 / 有效期"]
  C3{"C03 执行前复核<br/>当前权限 / 批准 / 条件 / 幂等"}
  ADAPTER["C03调用ActionAdapter<br/>首期仅ERP采购草稿、CRM内部工单"]
  WRITE["原ERP / CRM 写入及回执<br/>后续业务继续在原系统办理"]
  EXEC[("执行键、回执与业务结果关联<br/>唯一写入：C03")]
  G1["G01 权限、字段、工具与动作策略"]
  G2["G02 审计、观测与评测"]
  EXTERNAL -->|授权数据与来源元信息| D1
  D1 -->|来源记录及同步模式| D2
  D2 -->|已审核身份、转换与版本| V
  V -->|经D02公开读取端口| D3
  D1 -->|覆盖水位与同步状态| D3
  D3 -->|不达标：问题及受影响引用| BAD
  D3 -->|达标：固定数据范围及版本| SNAP
  D2 -->|原记录引用及转换版本| E
  SNAP -->|snapshotId定位及父证据，不复制清单| E
  USER -->|问题、范围及查看请求| W
  W -->|可信AnalysisContext| O
  CFG -.->|ScenarioHandler声明与选择| O
  O -.->|证据要求与冻结请求| D3
  O -.->|按参与者计划与有效预算调度| SC
  SC -.->|领域业务步骤调用| B1 & B2 & A2 & A3
  O -.->|仅联合报告补证，非领域步骤| A3
  SNAP -->|经数据端口读取固定版本| B1 & B2 & A2 & A3
  B1 -->|指标、分母、单位及缺项| ART
  B2 -.->|候选情景评价请求，使用同一指标定义| B1
  B1 -->|逐日评价结果引用| B2
  B2 -->|预测、情景参数、优化结果及B01评价引用| ART
  A2 -->|标签、字段、置信度及原文位置| ART
  ART -->|生产模块登记资产版本定位及血缘，不复制结果| E
  E -->|有权限的证据与知识| A3
  A3 -.->|受控指标查询计划| B1
  A3 -->|领域检索结果与能力缺项| SC
  A3 -->|联合报告补证结果与缺项| O
  ART -->|指标、预测和理解结果引用| SC
  SC -->|DomainResult，参与者/计划/快照引用与业务限制| O
  O -->|仅联合解释所需的获准上下文| A1
  SC -->|领域生成所需上下文，按场景步骤调用| A1
  A2 -->|按需模型理解请求| A1
  A3 -.->|需要模型规划时仅经A01调用| A1
  A1 -->|最小化的授权上下文| MODEL
  MODEL -->|模型输出，不作为源事实| A1
  A1 -->|联合解释模型输出或技术错误| O
  A1 -->|领域生成模型输出或技术错误| SC
  A1 -->|模型理解输出或技术错误| A2
  A1 -->|查询规划输出或技术错误| A3
  O -->|业务降级判定、综合审校后的报告与引用| REPORT
  REPORT -->|按当前访问权限展示| W
  W -->|用户明确生成建议后传报告/候选引用| C1
  C1 -->|建议版本与证据| W
  W -->|确认及审批操作界面| HUMAN
  HUMAN -->|发起人确认命令| C1
  C1 -->|用户提交后传不可变建议版本，尚未批准| C2
  HUMAN -->|另一授权人员决策| C2
  C2 -->|有效批准记录| C3
  W -.->|授权执行触发| C3
  C3 -.->|当前身份与动作范围复核| G1
  C3 -.->|证据有效性复核| D3
  C3 -->|通过复核的参数、执行键及来源条件| ADAPTER
  ADAPTER -->|受控创建命令| WRITE
  WRITE -->|确认回执或不确定结果| ADAPTER
  ADAPTER -->|外部ID、回执、未知及查询结果| C3
  C3 -->|执行意图、请求指纹与状态迁移| EXEC
  EXEC -->|执行状态与后续业务状态分开展示| W
  WRITE -->|后续原系统业务事实，经授权读取| D1
  V -->|经D02公开端口读取后续业务状态| C3
  G1 -.->|授权读取与字段范围| D1
  G1 -.->|检索、缓存及引用范围| A3
  G1 -.->|人员分离与批准范围| C2
  O & D1 & A1 & C2 & C3 -.->|受保护的追踪与评测事件| G2

  classDef control fill:#fff2de,stroke:#b37c24,color:#573c16
  classDef asset fill:#eaf4f0,stroke:#438a79,color:#174b40
  class C2,C3,G1 control
  class V,SNAP,E,ART,REPORT,EXEC asset
