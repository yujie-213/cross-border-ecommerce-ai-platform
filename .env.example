# Copy settings into your local ignored .env. No real credentials belong in Git.
S01_TEST_DB_HOST=127.0.0.1
S01_TEST_DB_PORT=3306
S01_TEST_DB_NAME=s01_a01_test_20261112
S01_TEST_DB_USER=
S01_TEST_DB_PASSWORD=""
S01_TEST_DB_CONNECT_TIMEOUT_SECONDS=5
S01_TEST_DB_SSL_CA=
COMMERCE_ENVIRONMENT=development
COMMERCE_LOG_LEVEL=INFO
# Populate trusted local/enterprise identity settings outside Git; never use a hardcoded key.
# Missing identity configuration fails closed. The process tests generate isolated test identities.
COMMERCE_AUTH_ISSUER=
COMMERCE_AUTH_AUDIENCE=
COMMERCE_AUTH_SIGNING_KEY=""
COMMERCE_BROWSER_ORIGIN=https://localhost
COMMERCE_LEASE_SECONDS=10
COMMERCE_HEARTBEAT_SECONDS=2
COMMERCE_POLL_SECONDS=0.2
COMMERCE_TASK_DEADLINE_SECONDS=120
COMMERCE_MAX_DELIVERY_ATTEMPTS=3
# Production composition registers no S01 or engineering fixture handler.
# ERP/model/external actions remain disabled.
# C-01: key is runtime-only. A configured key does NOT authorize paid calls.
COMMERCE_MODEL_PROVIDER=mock
COMMERCE_MODEL_BASE_URL=https://api.deepseek.com
COMMERCE_MODEL_NAME=deepseek-flash
COMMERCE_MODEL_API_KEY=""
COMMERCE_MODEL_NETWORK_ENABLED=false
COMMERCE_MODEL_TIMEOUT_SECONDS=15
COMMERCE_MODEL_MAX_OUTPUT_TOKENS=512
COMMERCE_MODEL_MAX_CONCURRENT=1
